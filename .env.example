# Public site URL (canonical SEO, sitemap, Open Graph)
APP_PUBLIC_URL=
APP_DOMAIN=

# Contacto en pie, /contacto y JSON-LD (default en código: frigotrace@davinchi.es)
CONTACT_EMAIL=frigotrace@davinchi.es

# SEO: set to true in production when the site should be indexed
SEO_INDEXABLE=

# Google Analytics measurement ID (optional; cookie banner only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML tag verification (optional)
GOOGLE_SITE_VERIFICATION=

# FrigoTrace application (header CTA)
NEXT_PUBLIC_APP_URL=https://app.frigotrace.es

# Puerto publicado en el host para docker-compose.prod.yml (contenedor sigue en 3300)
PORT=3500

# Formulario de contacto (mismo servicio que fitocloud-web → ApiTools)
CONTACT_FORM_API_URL=https://apitools.davinchi.es/api/Form/send-form
CONTACT_FORM_ID=15
# Clave API (cabecera x-api-key). En fitocloud-web se inyecta en el build como FORM_API_KEY.
FORM_API_KEY=

# Versión de privacidad registrada en cada envío (dataForm.privacidadVersion)
PRIVACY_POLICY_VERSION=1.0